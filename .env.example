# Browser-safe Supabase settings (Vite only exposes VITE_ variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server runtime
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
LESSONUP_DEV_AUTH=0

# DeepSeek: Pro uses Chat Completions; Flash uses Responses API.
# Model ids are intentionally pinned in code.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Supabase server credentials (never expose the service-role key to Vite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ character secrets used for resumable HITL state and scoped MCP tokens
AGENT_STATE_ENCRYPTION_KEY=
MCP_TOKEN_SECRET=

# Optional read-only web search
TAVILY_API_KEY=

# OpenAI-compatible BGE-M3 embedding service
BGE_M3_BASE_URL=
BGE_M3_API_KEY=
BGE_M3_MODEL=BAAI/bge-m3
KNOWLEDGE_WORKER_INTERVAL_MS=2000
