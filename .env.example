# Browser-safe Supabase settings (Vite only exposes VITE_ variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Install/build secret for the licensed Central Icons package. Export it in
# the shell or CI secret store before running npm install; it is not sent to Vite.
CENTRAL_LICENSE_KEY=

# Server runtime
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
LESSONUP_DEV_AUTH=0
# Independent Pi runtime remains off until a thread is explicitly enrolled.

# Any OpenAI-compatible model service. All three fields are required together.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_ID=
# Use openai-completions only when the endpoint does not implement Responses.
MODEL_API=openai-responses

# Supabase server credentials (never expose the service-role key to Vite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ character secrets used for resumable HITL state and scoped MCP tokens

# Optional: required only by `npm run eval:agent:release`. Ordinary `eval:agent`
# still records these measurements without enforcing a made-up budget.
# LESSONUP_EVAL_MAX_DURATION_MS=30000
# LESSONUP_EVAL_MAX_FIRST_OUTPUT_MS=8000
# LESSONUP_EVAL_MAX_MODEL_REQUESTS=4
# LESSONUP_EVAL_MAX_TOOL_CALLS=6
# LESSONUP_EVAL_MAX_INPUT_TOKENS=24000
AGENT_STATE_ENCRYPTION_KEY=
MCP_TOKEN_SECRET=

# Optional read-only web search
TAVILY_API_KEY=

# OpenAI-compatible BGE-M3 embedding service
BGE_M3_BASE_URL=
BGE_M3_API_KEY=
BGE_M3_MODEL=BAAI/bge-m3
KNOWLEDGE_WORKER_INTERVAL_MS=2000

# Classroom HTML presentations use the pinned Dashi Skill directly. No host
# filesystem path, worker process, or PPTX export setting is required.
