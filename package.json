{
  "name": "lessonup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n cloudflare,web -c cyan,magenta \"npm:dev:cloudflare\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:cloudflare": "wrangler dev --config wrangler.jsonc",
    "dev:api": "tsx watch server/index.ts",
    "db:migrate:local": "wrangler d1 migrations apply lessonup --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply lessonup --remote --config wrangler.jsonc",
    "db:status": "wrangler d1 list",
    "d1:provision-admin": "tsx scripts/provision-d1-admin.ts",
    "d1:import-supabase": "tsx scripts/import-supabase-to-d1.ts",
    "r2:import-supabase-storage": "tsx scripts/import-supabase-storage-to-r2.ts",
    "cloudflare:deploy": "tsx scripts/deploy-cloudflare.ts",
    "worker:skills": "tsx scripts/generate-worker-skill-catalog.ts",
    "dashi:prepare": "node scripts/prepare-dashi-browser.mjs",
    "dashi:catalog": "node scripts/generate-dashi-planning-catalog.mjs",
    "curriculum:prepare": "node scripts/prepare-curriculum-catalog.mjs",
    "curriculum:import": "tsx scripts/import-curriculum-catalog.ts",
    "curriculum:knowledge:import": "tsx scripts/import-curriculum-knowledge-sample.ts",
    "curriculum:knowledge:seed": "npm run curriculum:knowledge:import -- --source data/curriculum/knowledge/统编版七年级上册语文_整册知识点样本_V1.json --publish",
    "curriculum:standards:normalize": "tsx scripts/normalize-curriculum-standards.ts",
    "curriculum:standards:validate": "tsx scripts/index-curriculum-standards.ts validate",
    "curriculum:standards:import": "tsx scripts/index-curriculum-standards.ts import",
    "curriculum:standards:status": "tsx scripts/index-curriculum-standards.ts status",
    "curriculum:standards:publish": "tsx scripts/index-curriculum-standards.ts publish",
    "start:api": "tsx server/index.ts",
    "build:server": "tsc --project server/tsconfig.build.json",
    "start:knowledge": "tsx server/knowledge/worker-entry.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:cloudflare": "tsc --project cloudflare/tsconfig.json",
    "test": "vitest run",
    "test:legacy": "node --test src/features/lesson-files/lesson-file-regression.test.js",
    "test:e2e:agent": "playwright test --config playwright.agent.config.ts",
    "eval:agent": "tsx evals/run-agent-evals.ts",
    "eval:agent:release": "LESSONUP_EVAL_ENFORCE_PERFORMANCE_BUDGET=1 tsx evals/run-agent-evals.ts",
    "eval:curriculum-standards": "tsx evals/run-curriculum-standard-retrieval.ts",
    "check": "npm run typecheck && npm run test && npm run test:legacy && npm run test:e2e:agent && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "hono": "^4.12.30",
    "html-to-image": "1.11.13",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "officeparser": "^7.3.0",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadow-plugin": "^2.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "linkedom": "0.18.12",
    "shadcn": "^4.13.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.126.0"
  }
}
