{
  "name": "lessonup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:status": "node scripts/supabase-local.mjs status",
    "start:api": "tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:legacy": "node --test src/features/lesson-files/lesson-file-regression.test.js",
    "test:e2e:agent": "npm run db:start && playwright test --config playwright.agent.config.ts",
    "check": "npm run typecheck && npm run test && npm run test:legacy && npm run test:e2e:agent && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.13.3",
    "@supabase/supabase-js": "^2.110.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "officeparser": "^7.3.0",
    "openai": "^6.46.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "shadcn": "^4.13.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.10"
  }
}
